# Replace every placeholder in the deployment environment; never commit real secrets.
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
DJANGO_DEBUG=REPLACE_WITH_TRUE_OR_FALSE
DJANGO_SECURE_SSL_REDIRECT=REPLACE_WITH_TRUE_OR_FALSE
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_YOUR_HOSTNAME
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_YOUR_HOSTNAME
DATABASE_ENGINE=REPLACE_WITH_SQLITE_OR_POSTGRESQL
DATABASE_URL=REPLACE_WITH_POSTGRESQL_CONNECTION_URL
DATABASE_SSL_REQUIRE=REPLACE_WITH_TRUE_OR_FALSE
POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_HOST=REPLACE_WITH_DATABASE_HOST
POSTGRES_PORT=REPLACE_WITH_DATABASE_PORT
